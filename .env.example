# Disaster FoodBridge configuration. Copy this file to .env and fill in your own key.
# Never commit .env (it is in .gitignore).
#
# Where .env is read from (in this order; the first file that sets a name wins):
#   1. <project folder>/.env          e.g. final_project/.env
#   2. <parent folder>/.env           e.g. the course folder that contains final_project/
# Variables already set in your shell always win over both files.

# Required for the AI features (chat, report extraction, photo analysis).
# Without it the app still starts; AI actions show "PORTKEY_API_KEY is not set".
PORTKEY_API_KEY=your-portkey-api-key-here

# ---- Optional overrides (defaults shown) ----
# MODEL=gpt-6-luna
# PORT=8050

# Planning
# MEALS_PER_PERSON_PER_DAY=3
# PLANNING_WINDOW_HOURS=24

# Agent limits
# AGENT_REQUEST_LIMIT=3
# AGENT_TIMEOUT_SECONDS=60
# AGENT_MAX_HISTORY_MESSAGES=20

# Time zones (timestamps are stored in UTC)
# DISPLAY_TIMEZONE=Asia/Tokyo
# REPORT_TIMEZONE=Asia/Tokyo      # applied to report times without a zone, always flagged for review

# Data folders (relative to the project folder). On first start, missing working files are copied
# from SEED_DATA_DIR into LIVE_DATA_DIR; existing working files are never overwritten, and the app
# refuses to write into SEED_DATA_DIR.
# LIVE_DATA_DIR=data/live
# SEED_DATA_DIR=data/sample
# Per-file overrides (default: inside LIVE_DATA_DIR)
# SHELTER_LOG_PATH=data/live/shelter_log.csv
# INVENTORY_LOG_PATH=data/live/inventory_log.csv
# COMMITMENTS_LOG_PATH=data/live/commitments_log.csv
# FINALIZATION_DB_PATH=data/live/finalization.db
# USAGE_LOG_PATH=data/live/usage_log.jsonl
# Dashboard map positions (FICTIONAL training layout; the file must be labeled fictional)
# TRAINING_LOCATIONS_PATH=data/training_locations/fictional_training_locations.json
