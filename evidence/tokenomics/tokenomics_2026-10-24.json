    "pricing_page": "https://developers.openai.com/api/docs/pricing",
    "pricing_page_note": "https://platform.openai.com/docs/pricing redirects (301) here; https://openai.com/api/pricing/ returned HTTP 403 to the fetch tool",
    "prompt_caching_guide": "https://developers.openai.com/api/docs/guides/prompt-caching",
    "images_vision_guide": "https://developers.openai.com/api/docs/guides/images-vision",
    "secondary_sources_not_used_for_rates": [
      "https://www.eesel.ai/blog/gpt-6-luna-pricing",
      "https://aimlapi.com/models/gpt-6-luna (reseller, higher rates)",
      "https://braindetox.kr/en/posts/gpt6_sol_luna_release_2026.html"
    ]
  },
  "assumptions": [
    "A1 Rates: OpenAI's published standard-tier rates for gpt-6-luna (checked 2026-10-24). Our calls go through Portkey to an Azure OpenAI deployment; the course account's actual billing (rates, markups, credits) is unknown.",
    "A2 Caching: cached-read and cache-write token counts were never recorded, so the point estimate bills all input at the uncached rate. Bounds: for prompts of at least 1,024 tokens (the guide's minimum for GPT-5.6 and later), the low bound bills all input as cached reads (0.1x) and the high bound as 30-minute cache writes (1.25x); shorter prompts cannot be cached and use the uncached rate in all three figures.",
    "A3 Images: photo-analysis input_tokens are assumed to include the image tokens (the guide does not say for gpt-6-luna). Output tokens are assumed to include any reasoning tokens (not recorded separately).",
    "A4 Context: every recorded call is far below the 272,000-token long-context threshold, so short-context rates apply.",
    "A5 Repeats: identical prompts that returned identical outputs and token counts may have been served from a Portkey cache; whether those were billed is unknown, so they are counted as billed."
  ],
  "token_fields": {
    "measured": [
      "requests",
      "input_tokens",
      "output_tokens (PydanticAI RunUsage, per agent run)"
    ],
    "missing (available in PydanticAI/OpenAI usage but never recorded)": [
      "cached input tokens (input_tokens_details.cached_tokens / RunUsage.cache_read_tokens)",
      "cache-write tokens and their TTL (cache_write_tokens; ttl_30m / ttl_12h)",
      "reasoning tokens (output_reasoning_tokens)",
      "tool_calls for extraction/vision/screen runs",
      "per-request breakdown inside multi-request runs (chat tool calls)",
      "provider cost (RunUsage.cost) and Portkey's billed amount",
      "latency per call",
      "image token count separate from text tokens"
    ],
    "uncertain": [
      "whether identical repeated calls were served from a Portkey cache and billed (A5)",
      "whether photo input_tokens include image tokens and how gpt-6-luna counts them (A3)",
      "chat figures: observed in server logs and transcribed, raw logs not saved",
      "actual rates applied by Portkey / Azure to the course account (A1)"
    ]
  },
  "known_unrecorded_calls": [
    "P7 first chat call (succeeded, then the app crashed reading usage)",
    "P8 first tool call (HTTP 400 from Azure; billing unknown)",
    "P26 and P27 browser intake extractions (944 / 283 shown in the UI each; not saved)",
    "P29 follow-up that failed with HTTP 500 (cross-event-loop error)",
    "P31 browser intake check of Attack A (1,520 / 879 shown in the UI; extraction + screen)",
    "Any calls made outside the app (none known)"
